#!/usr/bin/env ruby
# frozen_string_literal: true

# Optional local check. Requires an already-installed Rack; never installs
# anything and never boots Rails. Select a version with RACK_VERSION if needed.
begin
  gem "rack", ENV["RACK_VERSION"] if ENV["RACK_VERSION"]
  require "rack"
  require "rack/lint"
  require "rack/mock"
rescue LoadError => error
  warn "Rack lint not run: #{error.message}. Supply an already-installed compatible Rack."
  exit 2
end
require "json"
require_relative "../lib/rails_runtime_info"

["GET", "POST", "HEAD"].each do |method|
  env = Rack::MockRequest.env_for("https://app.internal/_internal/diagnostics?check=yes", :method => method, :input => (method == "POST" ? "probe" : ""))
  status, headers, body = Rack::Lint.new(RailsRuntimeInfo::Endpoint).call(env)
  text = String.new
  begin
    body.each { |part| text << part }
  ensure
    body.close if body.respond_to?(:close)
  end
  abort "unexpected status #{status}" unless status == 200
  if method == "HEAD"
    abort "HEAD has a body" unless text.empty?
  else
    abort "invalid request echo" unless JSON.parse(text)["request"]["metadata"]["REQUEST_METHOD"] == method
    abort "wrong content length" unless headers["content-length"].to_i == text.bytesize
  end
end
puts "Rack #{Gem.loaded_specs.fetch('rack').version}: GET, POST and HEAD passed Rack::Lint"

# Optional route-local auth, still without Rails or any network server.
require "tmpdir"
Dir.mktmpdir("rails-runtime-info-lint-") do |directory|
  path = File.join(directory, "diagnostics.htpasswd")
  File.write(path, "alice:{SSHA}7f5oxwoLw9l/oUGGRBiKWy6vhH0Ac2FsdP8=\nbob:{PLAIN}second-pass\n")
  app = RailsRuntimeInfo::Endpoint.basic_auth(htpasswd: path)
  missing = RailsRuntimeInfo::Endpoint.basic_auth(htpasswd: nil)
  ["GET", "POST", "HEAD"].each do |method|
    [[app, nil, 401], [app, "alice:sample-pass", 200], [app, "bob:second-pass", 200], [app, "alice:bad", 401], [missing, nil, 503]].each do |target, credentials, expected|
      env = Rack::MockRequest.env_for("https://app.internal/_internal/diagnostics?what=-all", :method => method)
      env["HTTP_AUTHORIZATION"] = "Basic " + [credentials].pack("m0") if credentials
      status, headers, body = Rack::Lint.new(target).call(env)
      text = String.new
      begin
        body.each { |part| text << part }
      ensure
        body.close if body.respond_to?(:close)
      end
      abort "unexpected auth status #{status}" unless status == expected
      if method == "HEAD"
        abort "auth HEAD has a body" unless text.empty?
      else
        JSON.parse(text)
        abort "wrong auth length" unless headers["content-length"].to_i == text.bytesize
      end
    end
  end
end
puts "Rack optional authentication: success, 401, 503 and HEAD passed Rack::Lint"

# Query-only delay and its rejection paths; no network/server process needed.
["GET", "HEAD"].each do |method|
  [["what=-all&sleep=0.001", 200], ["sleep=31", 400], ["sleep=1&sleep=2", 400], ["sleep=1&what=unknown", 400]].each do |query, expected|
    env = Rack::MockRequest.env_for("https://app.internal/_internal/diagnostics?" + query, :method => method)
    status, headers, body = Rack::Lint.new(RailsRuntimeInfo::Endpoint).call(env)
    text = String.new
    begin
      body.each { |part| text << part }
    ensure
      body.close if body.respond_to?(:close)
    end
    abort "unexpected delay status #{status}" unless status == expected
    if method == "HEAD"
      abort "delay HEAD has a body" unless text.empty?
    else
      JSON.parse(text)
      abort "wrong delay length" unless headers["content-length"].to_i == text.bytesize
    end
  end
end
puts "Rack optional delay: success, 400 and HEAD passed Rack::Lint"
